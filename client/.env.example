# ─── Client Environment Variables ─────────────────────────────────────────────
# Copy this to .env.local for local dev overrides

# API base URL (leave empty to use Vite proxy in development)
# In production, set this to your deployed backend URL:
# VITE_API_URL=https://api.yourdomain.com/api

# Razorpay public key (safe to expose in frontend)
# VITE_RAZORPAY_KEY=rzp_live_xxxxxxxxxxxxx
